index 90a08f6..12215a6 100644
--- a/Jolt/Geometry/RayAABox.h
+++ b/Jolt/Geometry/RayAABox.h
@@ -131,6 +131,27 @@ JPH_INLINE Vec4 RayAABox4(Vec3Arg inOrigin, const RayInvDirection &inInvDirectio
 	return Vec4::sSelect(t_min, flt_max, no_intersection);
 }
 
+/// Intersect 4 AABBs with a ray that has exactly one non-zero direction component.
+/// The parallel bounds are provided first and the bounds along the ray direction last.
+JPH_INLINE Vec4 RayAABox4AxisAligned(float inParallelOrigin1, float inParallelOrigin2, float inRayOrigin, float inInvDirection, Vec4Arg inParallelBoundsMin1, Vec4Arg inParallelBoundsMin2, Vec4Arg inRayBoundsMin, Vec4Arg inParallelBoundsMax1, Vec4Arg inParallelBoundsMax2, Vec4Arg inRayBoundsMax)
+{
+	Vec4 ray_origin = Vec4::sReplicate(inRayOrigin);
+	Vec4 inv_direction = Vec4::sReplicate(inInvDirection);
+	Vec4 t1 = (inRayBoundsMin - ray_origin) * inv_direction;
+	Vec4 t2 = (inRayBoundsMax - ray_origin) * inv_direction;
+	Vec4 t_min = Vec4::sMin(t1, t2);
+	Vec4 t_max = Vec4::sMax(t1, t2);
+
+	Vec4 parallel_origin1 = Vec4::sReplicate(inParallelOrigin1);
+	Vec4 parallel_origin2 = Vec4::sReplicate(inParallelOrigin2);
+	UVec4 no_intersection = UVec4::sOr(
+		UVec4::sOr(Vec4::sLess(parallel_origin1, inParallelBoundsMin1), Vec4::sGreater(parallel_origin1, inParallelBoundsMax1)),
+		UVec4::sOr(Vec4::sLess(parallel_origin2, inParallelBoundsMin2), Vec4::sGreater(parallel_origin2, inParallelBoundsMax2)));
+	no_intersection = UVec4::sOr(no_intersection, Vec4::sLess(t_max, Vec4::sZero()));
+	no_intersection = UVec4::sOr(no_intersection, Vec4::sGreater(inRayBoundsMin, inRayBoundsMax));
+	return Vec4::sSelect(t_min, Vec4::sReplicate(FLT_MAX), no_intersection);
+}
