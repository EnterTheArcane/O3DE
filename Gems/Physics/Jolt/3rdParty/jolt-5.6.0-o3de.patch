+uint32 QuadTree::VisitStatistics(BroadPhase::EStatisticsQuery inQuery, uint32 inBroadPhaseLayer, const LayerToStats &inLayer, BroadPhase::StatisticsVisitor inVisitor, void *inContext, bool inReset) const
+{
+	unique_lock lock(mStatsMutex);
+	uint32 count = 0;
+
+	for (LayerToStats::value_type &entry : const_cast<LayerToStats &>(inLayer))
+	{
+		uint64 hash = 14695981039346656037ULL;
+		for (char value : entry.first)
+		{
+			hash ^= uint8(value);
+			hash *= 1099511628211ULL;
+		}
+
+		BroadPhase::Statistics value;
+		value.mFilterDescriptionHash = hash;
+		value.mTotalTicks = entry.second.mTotalTicks;
+		value.mCollectorTicks = entry.second.mCollectorTicks;
+		value.mNumQueries = entry.second.mNumQueries;
+		value.mNodesVisited = entry.second.mNodesVisited;
+		value.mBodiesVisited = entry.second.mBodiesVisited;
+		value.mHitsReported = entry.second.mHitsReported;
+		value.mBroadPhaseLayer = inBroadPhaseLayer;
+		value.mQuery = inQuery;
+
+		if (value.mNumQueries != 0 || value.mHitsReported != 0 || value.mTotalTicks != 0)
+		{
+			inVisitor(value, inContext);
+			++count;
+		}
+
+		if (inReset)
+			entry.second = {};
+	}
+	return count;
+}
