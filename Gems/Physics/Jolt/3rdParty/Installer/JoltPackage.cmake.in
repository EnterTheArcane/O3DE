set(Jolt_PACKAGE_VERSION "5.6.0")
set(Jolt_PACKAGE_COMMIT "e77f175595e64cb44218cc9d9d56fc365ad0e36a")
set(Jolt_PACKAGE_PATCH_REVISION "jolt-v5.6.0-o3de-10")
set(Jolt_PACKAGE_PATCH_HASH "@jolt_patch_hash@")
set(Jolt_PACKAGE_DOUBLE_PRECISION @LY_JOLT_DOUBLE_PRECISION@)
set(Jolt_PACKAGE_DEBUG_RENDERING @LY_JOLT_ENABLE_DEBUG_RENDERING@)
set(Jolt_PACKAGE_DETAILED_PROFILING @LY_JOLT_ENABLE_DETAILED_PROFILING@)
set(Jolt_PACKAGE_SIMULATION_STATISTICS @LY_JOLT_ENABLE_SIMULATION_STATISTICS@)
