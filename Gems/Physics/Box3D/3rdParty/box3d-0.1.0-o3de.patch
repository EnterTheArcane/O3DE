+{
+	B3_ASSERT( b3IsValidRay( input ) );
+	b3CastOutput output = { 0 };
+	float lower = 0.0f;
+	float upper = input->maxFraction;
+	int bestAxis = B3_NULL_INDEX;
+	float normalSign = 0.0f;
+
+	const float origins[3] = { input->origin.x, input->origin.y, input->origin.z };
+	const float translations[3] = { input->translation.x, input->translation.y, input->translation.z };
+	const float lowerBounds[3] = { shape->aabb.lowerBound.x, shape->aabb.lowerBound.y, shape->aabb.lowerBound.z };
+	const float upperBounds[3] = { shape->aabb.upperBound.x, shape->aabb.upperBound.y, shape->aabb.upperBound.z };
+	int nonZeroAxisCount = ( translations[0] != 0.0f ) + ( translations[1] != 0.0f ) + ( translations[2] != 0.0f );
+	if ( nonZeroAxisCount == 1 )
+	{
+		int movingAxis = translations[0] != 0.0f ? 0 : translations[1] != 0.0f ? 1 : 2;
+		int fixedAxis1 = ( movingAxis + 1 ) % 3;
+		int fixedAxis2 = ( movingAxis + 2 ) % 3;
+		if ( origins[fixedAxis1] < lowerBounds[fixedAxis1] || origins[fixedAxis1] > upperBounds[fixedAxis1] ||
+			 origins[fixedAxis2] < lowerBounds[fixedAxis2] || origins[fixedAxis2] > upperBounds[fixedAxis2] )
+		{
+			return output;
+		}
+
+		float inverseTranslation = 1.0f / translations[movingAxis];
+		float fraction1 = ( lowerBounds[movingAxis] - origins[movingAxis] ) * inverseTranslation;
+		float fraction2 = ( upperBounds[movingAxis] - origins[movingAxis] ) * inverseTranslation;
+		lower = b3MinFloat( fraction1, fraction2 );
+		upper = b3MaxFloat( fraction1, fraction2 );
+		if ( lower <= 0.0f || lower > input->maxFraction || upper < 0.0f )
+		{
+			return output;
+		}
+
+		output.point = b3Add( input->origin, b3MulSV( lower, input->translation ) );
+		float sign = fraction1 < fraction2 ? -1.0f : 1.0f;
+		output.normal = movingAxis == 0 ? (b3Vec3){ sign, 0.0f, 0.0f }
+			: movingAxis == 1         ? (b3Vec3){ 0.0f, sign, 0.0f }
+									: (b3Vec3){ 0.0f, 0.0f, sign };
+		output.fraction = lower;
+		output.hit = true;
+		return output;
+	}
+
+	for ( int axis = 0; axis < 3; ++axis )
+	{
+		float translation = translations[axis];
+		if ( translation == 0.0f )
+		{
+			if ( origins[axis] < lowerBounds[axis] || origins[axis] > upperBounds[axis] )
+			{
+				return output;
+			}
