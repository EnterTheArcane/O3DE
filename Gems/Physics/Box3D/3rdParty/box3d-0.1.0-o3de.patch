+bool b3IsBoxHull( const b3HullData* shape )
+{
+	if ( shape->vertexCount != 8 || shape->edgeCount != 24 || shape->faceCount != 6 )
+	{
+		return false;
+	}
+
+	const b3Plane* planes = b3GetHullPlanes( shape );
+	const float parallelTolerance = 16.0f * FLT_EPSILON;
+	return b3Dot( planes[0].normal, planes[1].normal ) < -1.0f + parallelTolerance &&
+		b3Dot( planes[2].normal, planes[3].normal ) < -1.0f + parallelTolerance &&
+		b3Dot( planes[4].normal, planes[5].normal ) < -1.0f + parallelTolerance &&
+		b3AbsFloat( b3Dot( planes[0].normal, planes[2].normal ) ) < parallelTolerance &&
+		b3AbsFloat( b3Dot( planes[0].normal, planes[4].normal ) ) < parallelTolerance &&
+		b3AbsFloat( b3Dot( planes[2].normal, planes[4].normal ) ) < parallelTolerance;
+}
+
+bool b3OverlapBoxHull( const b3HullData* shape, b3Transform shapeTransform, const b3ShapeProxy* proxy )
+{
+	B3_ASSERT( proxy->count == 1 );
+	const b3Plane* planes = b3GetHullPlanes( shape );
+	b3Vec3 center = b3InvTransformPoint( shapeTransform, proxy->points[0] );
+	float separation0 = b3MaxFloat( b3Dot( planes[0].normal, center ) - planes[0].offset,
+		b3Dot( planes[1].normal, center ) - planes[1].offset );
+	float separation1 = b3MaxFloat( b3Dot( planes[2].normal, center ) - planes[2].offset,
+		b3Dot( planes[3].normal, center ) - planes[3].offset );
+	float separation2 = b3MaxFloat( b3Dot( planes[4].normal, center ) - planes[4].offset,
+		b3Dot( planes[5].normal, center ) - planes[5].offset );
+	separation0 = b3MaxFloat( separation0, 0.0f );
+	separation1 = b3MaxFloat( separation1, 0.0f );
+	separation2 = b3MaxFloat( separation2, 0.0f );
+	float radius = proxy->radius + B3_OVERLAP_SLOP;
+	return separation0 * separation0 + separation1 * separation1 + separation2 * separation2 < radius * radius;
+}
