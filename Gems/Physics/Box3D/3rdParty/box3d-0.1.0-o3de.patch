+		float inverseTranslation = 1.0f / translation;
+		float fraction1 = ( lowerBounds[axis] - origins[axis] ) * inverseTranslation;
+		float fraction2 = ( upperBounds[axis] - origins[axis] ) * inverseTranslation;
