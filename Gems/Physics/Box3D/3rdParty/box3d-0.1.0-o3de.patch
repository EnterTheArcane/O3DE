+int b3CollideMoverAndTriangle( b3PlaneResult* result, const b3Vec3* triangle, const b3Capsule* mover )
+{
+	b3Vec3 oriented[3] = { triangle[0], triangle[1], triangle[2] };
+	b3Plane plane = b3MakePlaneFromPoints( oriented[0], oriented[1], oriented[2] );
+	b3Vec3 center = b3Lerp( mover->center1, mover->center2, 0.5f );
+	float separation = b3PlaneSeparation( plane, center );
+	bool canonicalFlip = separation == 0.0f &&
+		( plane.normal.x < 0.0f || ( plane.normal.x == 0.0f &&
+			( plane.normal.y < 0.0f || ( plane.normal.y == 0.0f && plane.normal.z < 0.0f ) ) ) );
+	if ( separation < 0.0f || canonicalFlip )
+	{
+		b3Vec3 swap = oriented[1];
+		oriented[1] = oriented[2];
+		oriented[2] = swap;
+	}
+
+	b3LocalManifoldPoint manifoldPoints[2];
+	b3LocalManifold manifold = { .points = manifoldPoints };
+	b3SimplexCache cache = { 0 };
+	b3CollideCapsuleAndTriangle( &manifold, 2, mover, oriented, &cache );
+	if ( manifold.pointCount == 0 )
+	{
+		return 0;
+	}
+
+	int deepestIndex = 0;
+	for ( int i = 1; i < manifold.pointCount; ++i )
+	{
+		if ( manifold.points[i].separation < manifold.points[deepestIndex].separation )
+		{
+			deepestIndex = i;
+		}
+	}
+
+	b3LocalManifoldPoint point = manifold.points[deepestIndex];
+	if ( point.separation > 0.0f )
+	{
+		return 0;
+	}
+
+	result->plane = (b3Plane){ manifold.normal, -point.separation };
+	result->point = b3MulSub( point.point, 0.5f * point.separation, manifold.normal );
+	return 1;
+}
