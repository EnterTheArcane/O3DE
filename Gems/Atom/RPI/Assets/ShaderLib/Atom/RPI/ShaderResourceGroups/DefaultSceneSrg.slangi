#ifndef AZ_COLLECTING_PARTIAL_SRGS
#error Do not include this file directly. Include the main .srgi file instead.
#endif

// TODO(slang-port): partial ShaderResourceGroup SceneSrg - compose into the aggregate struct
[AtomShaderResourceGroup(/* TODO(slang-port): unresolved semantic None */ 0)]
struct SceneSrgLayout
{
    float m_time; // number of seconds since the application started
    // m_prevTime is the value of m_time when the SceneSRG was last updated.
    // If your shader runs on a different frequency from SceneSRG, you will get unexpected results from using m_prevTime.
    float m_prevTime;
};

