// The ViewSrg free functions and static constants, ported field-for-field from the AZSL editorial
// source (ShaderResourceGroups/ViewSrg.azsli and its Decals/CoreLights/PostProcessing partials). This
// file is textually included into the ViewSrgAccessor body by the generated ViewSrg.slangi, so member
// references below resolve through the accessor's forwarding properties and the constants become
// accessor members reached as `ViewSrg.MaxCascadeCount`. Add an entry here whenever a shader uses a
// new ViewSrg::Fn() or ViewSrg::CONSTANT.

// static const members declared inside the AZSL ViewSrg SRG
static const uint MaxGoboTextureCount = 5;
static const uint MaxCascadeCount = 4;
static const uint DirectionalLightShadowDebugColoringBitMask = 1;

float GetNearZ()
{
    return m_linearizeDepthConstants.x;
}

float GetFarZ()
{
    return m_linearizeDepthConstants.y;
}

float GetFarZTimesNearZ()
{
    return m_linearizeDepthConstants.z;
}

float GetFarZMinusNearZ()
{
    return m_linearizeDepthConstants.w;
}

float3 GetViewSpacePosition(float2 screenUV, float linearDepth)
{
    float2 screenRay = (screenUV * m_unprojectionConstants.xy + m_unprojectionConstants.zw);
    return float3(screenRay * linearDepth, linearDepth);
}

// PostProcessing/ViewSrg.azsli
float GetExposureValueCompensation()
{
    return m_exposureControl.m_exposureValueCompensation;
}

// CoreLights/ViewSrg.azsli
uint PolygonLightGetStartIndex(uint index)
{
    return index >> 16;
}

uint PolygonLightGetEndIndex(uint index)
{
    return index & 0x0000FFFF;
}
