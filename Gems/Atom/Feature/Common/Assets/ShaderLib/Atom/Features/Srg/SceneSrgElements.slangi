#pragma once

// Field-accurate Slang ports of the element structs referenced by the SceneSrg binding ABI
// (SceneSrg.slangi). See ViewSrgElements.slangi for the porting rules; SharedSrgBindingAbiTests
// validates every stride against the AZSL editorial source. row_major is spelled explicitly on
// float3x4 members because major-ness changes the element stride (row_major 48 vs column_major 64).

// CoreLights/SceneSrg.azsli references LightStructures.azsli
struct DirectionalLight
{
    float3 m_direction;
    float m_angularRadius;
    float3 m_rgbIntensityLux;
    float m_affectsGIFactor;
    bool m_affectsGI;
    uint m_lightingChannelMask;
    float2 m_padding;
};

// SkyBox/SceneSrg.azsli
struct PhysicalSkyData
{
    float4 m_physicalSkyParameterA;
    float4 m_physicalSkyParameterB;
    float4 m_physicalSkyParameterC;
    float4 m_physicalSkyParameterD;
    float4 m_physicalSkyParameterE;
    float4 m_physicalSkyParameterF;
    float4 m_physicalSkyParameterG;
    float4 m_physicalSkyParameterH;
    float4 m_physicalSkyParameterI;
    float4 m_physicalSkyParameterZ;
    float4 m_physicalSkySunParameters;
    float4 m_physicalSkySunDirection;
    float4 m_physicalSkySunRGB;
    float4 m_physicalSkyAndSunIntensity;
};

// MeshInfo/MeshInfo.azsli
struct MeshInfo
{
    int m_indexBufferIndex;
    int m_positionBufferIndex;
    int m_normalBufferIndex;
    int m_uv0BufferIndex;
    int m_uv1BufferIndex;
    int m_tangentBufferIndex;
    int m_bitangentBufferIndex;
    int m_clusterBufferIndex;

    uint m_indexBufferByteOffset;
    uint m_positionBufferByteOffset;
    uint m_normalBufferByteOffset;
    uint m_uv0BufferByteOffset;
    uint m_uv1BufferByteOffset;
    uint m_tangentBufferByteOffset;
    uint m_bitangentBufferByteOffset;

    uint m_indexBufferByteStride;
    uint m_positionBufferByteStride;
    uint m_normalBufferByteStride;
    uint m_uv0BufferByteStride;
    uint m_uv1BufferByteStride;
    uint m_tangentBufferByteStride;
    uint m_bitangentBufferByteStride;

    uint m_indexFormat;
    uint m_positionFormat;
    uint m_normalFormat;
    uint m_uv0Format;
    uint m_uv1Format;
    uint m_tangentFormat;
    uint m_bitangentFormat;

    uint m_objectIdForTransform;
    uint m_lightingChannels;
    uint m_materialTypeId;
    uint m_materialInstanceId;
    uint m_uvStreamTangentBitmask;
    uint m_flags;

    int m_padding;
};

// PBR/Lights/ReflectionProbeData.azsli (referenced by MaterialInfo)
struct ReflectionProbeData
{
    row_major float3x4 m_modelToWorld;
    row_major float3x4 m_modelToWorldInverse;
    float3 m_outerObbHalfLengths;
    float m_exposure;
    float3 m_innerObbHalfLengths;
    bool m_useReflectionProbe;
    bool m_useParallaxCorrection;
    float3 m_padding;
};

// FallbackPBRMaterial/MaterialInfo.azsli
struct MaterialInfo
{
    float4 m_baseColor;
    float4 m_irradianceColor;
    float3 m_emissiveColor;
    float m_metallicFactor;
    float m_roughnessFactor;
    int m_baseColorImage;
    int m_normalImage;
    int m_metallicImage;
    int m_roughnessImage;
    int m_emissiveImage;
    uint m_reflectionProbeCubeMapIndex;
    uint m_pad;
    ReflectionProbeData m_reflectionProbeData;
};

// Terrain/SceneSrg.azsli (Terrain gem partial; a loose SRG-constant of struct type)
struct TerrainWorldData
{
    float m_zMin;
    float m_zMax;
    float m_zExtents;
    float m_padding;
};

// ShaderResourceGroups/SceneSrg.azsli (inline structs)
struct ObjectToWorld
{
    row_major float3x4 m_transform;
};

struct NormalToWorld
{
    row_major float3x4 m_transform;
};
