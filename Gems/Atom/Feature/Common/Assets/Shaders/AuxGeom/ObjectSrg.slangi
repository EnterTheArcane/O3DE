// [slang-port] removed: #include <Atom/Features/SrgSemantics.azsli> has no Slang counterpart

[AtomShaderResourceGroup(SrgBindingSlot.Draw)]
struct ObjectSrgLayout
{
    float4 m_color;
    row_major float3x4 m_modelToWorld;
    row_major float4x4 m_viewProjectionOverride;
    float m_pointSize;

    float4x4 GetWorldMatrix()
    {
        float4x4 modelToWorld = float4x4(
            float4(1, 0, 0, 0),
            float4(0, 1, 0, 0),
            float4(0, 0, 1, 0),
            float4(0, 0, 0, 1));

        modelToWorld[0] = m_modelToWorld[0];
        modelToWorld[1] = m_modelToWorld[1];
        modelToWorld[2] = m_modelToWorld[2];
        return modelToWorld;
    }
};
ParameterBlock<ObjectSrgLayout> ObjectSrg;
