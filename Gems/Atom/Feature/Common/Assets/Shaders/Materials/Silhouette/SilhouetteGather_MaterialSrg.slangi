#pragma once 

// [slang-port] removed: #include <Atom/Features/SrgSemantics.azsli> has no Slang counterpart
#include "../MaterialInputs/SilhouetteInput.slangi"

struct MaterialParameters {
    float4 m_color;
    float m_alpha;
    float m_depthBias;
    float m_outlineSize;
    float m_padding0;
    float4 m_uvMatrixRow0;
    float4 m_uvMatrixRow1;
    float4 m_uvMatrixRow2;
};

[AtomShaderResourceGroup(SrgBindingSlot.Material)]
struct MaterialSrgLayout
{
    MaterialParameters m_params;
};
ParameterBlock<MaterialSrgLayout> MaterialSrg;

const MaterialParameters GetMaterialParameters()
{
    MaterialParameters params = MaterialSrg.m_params;
    // m_uvMatrixRow0/1/2 are read directly from the SRG (no float3x3 copy needed).
    return params;
}

