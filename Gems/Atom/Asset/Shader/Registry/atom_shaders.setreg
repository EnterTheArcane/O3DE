{
    "Amazon": {
        "AssetProcessor": {
            "Settings": {
                "ScanFolder ShaderHeaders": {
                    "watch": "@EXEFOLDER@/Builders/ShaderHeaders",
                    "display": "Shader compiler headers",
                    "recursive": 1,
                    "order": 50000
                }
            }
        }
    },
    "O3DE": {
        "Atom": {
            "Shaders": {
                "BuildVariants": true,
                "Build": {
                    "ConfigPath": "@gemroot:AtomShader@/Assets/Config/Shader"
                }
            }
        }
    }
}
