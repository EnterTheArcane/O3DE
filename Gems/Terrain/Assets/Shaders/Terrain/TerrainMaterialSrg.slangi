#pragma once

// [slang-port] removed: #include <Atom/Features/SrgSemantics.azsli> has no Slang counterpart

[AtomShaderResourceGroup(SrgBindingSlot.Material)]
struct TerrainMaterialSrgLayout
{
    [AtomStaticSampler("Linear", "Linear", "Linear", "Wrap", "Wrap", "Wrap", 16, "Never", "Filter", "TransparentBlack")]
    SamplerState m_detailSampler;

    [AtomStaticSampler("Linear", "Linear", "Linear", "Clamp", "Clamp", "Wrap", 16, "Never", "Filter", "TransparentBlack")]
    SamplerState m_macroSampler;

    // Base Color
    float3 m_baseColor;

    // Detail Material Properties
    float m_detailTextureMultiplier;
    float m_detailFadeDistance;
    float m_detailFadeLength;
};
ParameterBlock<TerrainMaterialSrgLayout> TerrainMaterialSrg;
