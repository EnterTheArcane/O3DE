#pragma once 

// [slang-port] removed: #include <Atom/Features/SrgSemantics.azsli> has no Slang counterpart

// Note: Since we define the parameters as members of the SRG, we can't use this material in a deferred or raytracing pipeline.
// But since the AutoBrick.materialtype specifies only the AutoBrick_ForwardPass.shader, that wouldn't have worked anyway
[AtomShaderResourceGroup(SrgBindingSlot.Material)]
struct AutoBrickSrgLayout
{
    // Shape...
    float m_brickWidth;
    float m_brickHeight;
    float m_lineWidth;
    float m_lineDepth;
    float m_brickOffset;

    // Appearance...
    float3 m_brickColor;
    float m_brickNoiseFactor;
    float3 m_lineColor;
    float m_lineNoiseFactor;
    float m_brickColorBleed;
    float m_aoFactor;
    float m_debugValue;
    float m_debugValueScale;

    [AtomStaticSampler("Linear", "Linear", "Linear", "Wrap", "Wrap", "Wrap", 0, "Never", "Filter", "TransparentBlack")]
    SamplerState m_sampler;
    Texture2D m_noise;
};
ParameterBlock<AutoBrickSrgLayout> AutoBrickSrg;
