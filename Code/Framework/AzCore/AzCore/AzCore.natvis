  <Type Name="AZStd::basic_string&lt;char,*,*&gt;">
    <DisplayString Condition="m_storage.m_first.m_shortData.m_packed.m_ssoActive">{m_storage.m_first.m_shortData.m_buffer,s}</DisplayString>
    <DisplayString Condition="!m_storage.m_first.m_shortData.m_packed.m_ssoActive">{m_storage.m_first.m_allocatedData.m_data,s}</DisplayString>
    <StringView Condition="m_storage.m_first.m_shortData.m_packed.m_ssoActive">m_storage.m_first.m_shortData.m_buffer,s</StringView>
    <StringView Condition="!m_storage.m_first.m_shortData.m_packed.m_ssoActive">m_storage.m_first.m_allocatedData.m_data,s</StringView>
    <Expand>
      <Item Name="[size]" Condition="m_storage.m_first.m_shortData.m_packed.m_ssoActive">(size_t)m_storage.m_first.m_shortData.m_packed.m_size</Item>
      <Item Name="[size]" Condition="!m_storage.m_first.m_shortData.m_packed.m_ssoActive">m_storage.m_first.m_allocatedData.m_size</Item>
      <Item Name="[capacity]" Condition="m_storage.m_first.m_shortData.m_packed.m_ssoActive">m_storage.m_first.m_shortData.Capacity</Item>
      <Item Name="[capacity]" Condition="!m_storage.m_first.m_shortData.m_packed.m_ssoActive">m_storage.m_first.m_allocatedData.m_capacity</Item>
      <Item Name="[is packed]">(bool)m_storage.m_first.m_shortData.m_packed.m_ssoActive</Item>
      <ArrayItems>
        <Size Condition="m_storage.m_first.m_shortData.m_packed.m_ssoActive">m_storage.m_first.m_shortData.m_packed.m_size,u</Size>
        <Size Condition="!m_storage.m_first.m_shortData.m_packed.m_ssoActive">m_storage.m_first.m_allocatedData.m_size</Size>
        <ValuePointer Condition="m_storage.m_first.m_shortData.m_packed.m_ssoActive">m_storage.m_first.m_shortData.m_buffer</ValuePointer>
        <ValuePointer Condition="!m_storage.m_first.m_shortData.m_packed.m_ssoActive">m_storage.m_first.m_allocatedData.m_data</ValuePointer>
      </ArrayItems>
