# Resolve the expressions used by runtime file registrations before assigning output ownership.
# CMake evaluates general generator expressions too late to compare the destination paths here.
function(ly_runtime_paths expression config out)
    set(paths "${expression}")
    string(TOUPPER "${config}" upper_config)
    while(paths MATCHES "\\$<([^$<>]*)>")
        set(token "${CMAKE_MATCH_0}")
        set(contents "${CMAKE_MATCH_1}")
        if(contents STREQUAL "CONFIG")
            set(value "${config}")
        elseif(contents STREQUAL "SEMICOLON")
            set(value ";")
        elseif(contents MATCHES "^CONFIG:(.*)$")
            string(TOUPPER "${CMAKE_MATCH_1}" config_list)
            string(REPLACE "," ";" config_list "${config_list}")
            set(value 0)
            if(upper_config IN_LIST config_list)
                set(value 1)
            endif()
        elseif(contents MATCHES "^IF:([01]),([^,]*),(.*)$")
            set(value "${CMAKE_MATCH_3}")
            if(CMAKE_MATCH_1 STREQUAL "1")
                set(value "${CMAKE_MATCH_2}")
            endif()
        elseif(contents MATCHES "^([01]):(.*)$")
            set(value "")
            if(CMAKE_MATCH_1 STREQUAL "1")
                set(value "${CMAKE_MATCH_2}")
            endif()
        elseif(contents MATCHES "^TARGET_FILE(_DIR|_NAME)?:(.+)$")
            set(component "${CMAKE_MATCH_1}")
            ly_runtime_target_file("${CMAKE_MATCH_2}" "${config}" value)
            if(component STREQUAL "_DIR")
                cmake_path(GET value PARENT_PATH value)
            elseif(component STREQUAL "_NAME")
                cmake_path(GET value FILENAME value)
            endif()
        else()
            message(FATAL_ERROR "Unsupported runtime path expression ${token} in ${expression} (${config})")
        endif()
        string(REPLACE "${token}" "${value}" paths "${paths}")
    endwhile()
    if(paths MATCHES "\\$<")
        message(FATAL_ERROR "Unresolved runtime path expression ${expression} (${config})")
    endif()
    set(${out} "${paths}" PARENT_SCOPE)
endfunction()

function(ly_runtime_target_file target config out)
    ly_de_alias_target("${target}" target)
    string(TOUPPER "${config}" upper_config)
    get_property(location_cached GLOBAL PROPERTY "LY_RUNTIME_FILE_${target}_${upper_config}" SET)
    if(location_cached)
        get_property(location GLOBAL PROPERTY "LY_RUNTIME_FILE_${target}_${upper_config}")
        set(${out} "${location}" PARENT_SCOPE)
        return()
    endif()

    get_property(is_imported TARGET "${target}" PROPERTY IMPORTED)
    if(is_imported)
        get_property(mapped_set TARGET "${target}" PROPERTY "MAP_IMPORTED_CONFIG_${upper_config}" SET)
        if(mapped_set)
            get_property(configurations TARGET "${target}" PROPERTY "MAP_IMPORTED_CONFIG_${upper_config}")
        else()
            get_property(imported_configurations TARGET "${target}" PROPERTY IMPORTED_CONFIGURATIONS)
            set(configurations "${upper_config};;${imported_configurations}")
        endif()
        foreach(mapped IN LISTS configurations)
            string(TOUPPER "${mapped}" mapped)
            if(mapped STREQUAL "")
                get_property(location TARGET "${target}" PROPERTY IMPORTED_LOCATION)
            else()
                get_property(location TARGET "${target}" PROPERTY "IMPORTED_LOCATION_${mapped}")
            endif()
            if(location)
                break()
            endif()
        endforeach()
        if(mapped_set AND configurations STREQUAL "")
            get_property(location TARGET "${target}" PROPERTY IMPORTED_LOCATION)
        endif()
        if(NOT location)
            message(FATAL_ERROR "Cannot find runtime file of imported target ${target} for ${config}")
        endif()
    else()
        get_property(type TARGET "${target}" PROPERTY TYPE)
        get_property(binary_dir TARGET "${target}" PROPERTY BINARY_DIR)
        set(artifact RUNTIME)
        if(type STREQUAL "EXECUTABLE")
            set(prefix "")
            set(suffix "${CMAKE_EXECUTABLE_SUFFIX}")
        elseif(type STREQUAL "MODULE_LIBRARY")
            set(artifact LIBRARY)
            set(prefix "${CMAKE_SHARED_MODULE_PREFIX}")
            set(suffix "${CMAKE_SHARED_MODULE_SUFFIX}")
        else()
            if(NOT WIN32)
                set(artifact LIBRARY)
            endif()
            set(prefix "${CMAKE_SHARED_LIBRARY_PREFIX}")
            set(suffix "${CMAKE_SHARED_LIBRARY_SUFFIX}")
        endif()
        foreach(property PREFIX SUFFIX)
            get_property(is_set TARGET "${target}" PROPERTY "${property}" SET)
            if(is_set)
                string(TOLOWER "${property}" variable)
                get_property(${variable} TARGET "${target}" PROPERTY "${property}")
            endif()
        endforeach()
        foreach(property "${artifact}_OUTPUT_NAME_${upper_config}" "${artifact}_OUTPUT_NAME"
            "OUTPUT_NAME_${upper_config}" "${upper_config}_OUTPUT_NAME" OUTPUT_NAME)
            get_property(name TARGET "${target}" PROPERTY "${property}")
            if(name)
                break()
            endif()
        endforeach()
        if(NOT name)
            set(name "${target}")
        endif()
        get_property(postfix TARGET "${target}" PROPERTY "${upper_config}_POSTFIX")
        get_property(directory TARGET "${target}" PROPERTY "${artifact}_OUTPUT_DIRECTORY_${upper_config}")
        if(NOT directory)
            get_property(directory TARGET "${target}" PROPERTY "${artifact}_OUTPUT_DIRECTORY")
            if(NOT directory)
                set(directory "${binary_dir}")
            endif()
            get_property(multi_config GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
            if(multi_config AND NOT directory MATCHES "\\$<")
                string(APPEND directory "/${config}")
            endif()
        endif()
        set(filename "${prefix}${name}${postfix}${suffix}")
        if(type STREQUAL "SHARED_LIBRARY" AND NOT WIN32)
            get_property(framework TARGET "${target}" PROPERTY FRAMEWORK)
            get_property(no_soname TARGET "${target}" PROPERTY NO_SONAME)
            if(framework)
                get_property(framework_version TARGET "${target}" PROPERTY FRAMEWORK_VERSION)
                if(NOT framework_version)
                    set(framework_version A)
                endif()
                set(filename "${name}${postfix}.framework/Versions/${framework_version}/${name}${postfix}")
            elseif(NOT no_soname)
                get_property(version TARGET "${target}" PROPERTY VERSION)
                if(NOT version)
                    get_property(version TARGET "${target}" PROPERTY SOVERSION)
                endif()
                if(version)
                    if(APPLE)
                        set(filename "${prefix}${name}${postfix}.${version}${suffix}")
                    else()
                        string(APPEND filename ".${version}")
                    endif()
                endif()
            endif()
        elseif(APPLE AND type STREQUAL "EXECUTABLE")
            get_property(bundle TARGET "${target}" PROPERTY MACOSX_BUNDLE)
            if(bundle)
                get_property(bundle_extension TARGET "${target}" PROPERTY BUNDLE_EXTENSION)
                if(NOT bundle_extension)
                    set(bundle_extension app)
                endif()
                set(filename "${name}${postfix}.${bundle_extension}/Contents/MacOS/${filename}")
            endif()
        endif()
        ly_runtime_paths("${directory}/${filename}" "${config}" location)
        cmake_path(ABSOLUTE_PATH location BASE_DIRECTORY "${binary_dir}" NORMALIZE)
    endif()
    set_property(GLOBAL PROPERTY "LY_RUNTIME_FILE_${target}_${upper_config}" "${location}")
    set(${out} "${location}" PARENT_SCOPE)
endfunction()

function(ly_stage_runtime_files)
    get_property(targets GLOBAL PROPERTY LY_RUNTIME_STAGING_TARGETS)
    get_property(multi_config GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
    if(multi_config)
        set(configurations "${CMAKE_CONFIGURATION_TYPES}")
    else()
        set(configurations "${CMAKE_BUILD_TYPE}")
    endif()

    foreach(target IN LISTS targets)
        get_property(bundle TARGET "${target}" PROPERTY MACOSX_BUNDLE)
        if(bundle)
            continue()
        endif()
        o3de_get_dependencies_for_target(TARGET "${target}"
            COPY_DEPENDENCIES_VAR copy_dependencies
            TARGET_DEPENDENCIES_VAR target_dependencies
            LINK_DEPENDENCIES_VAR link_dependencies
            IMPORTED_DEPENDENCIES_VAR imported_dependencies)
        set(dependencies ${copy_dependencies} ${target_dependencies} ${link_dependencies} ${imported_dependencies})
        list(REMOVE_DUPLICATES dependencies)
        get_property(binary_dir TARGET "${target}" PROPERTY BINARY_DIR)
        foreach(config IN LISTS configurations)
            ly_runtime_target_file("${target}" "${config}" target_file)
            cmake_path(GET target_file PARENT_PATH output_directory)
            set(output_key "${target_file}")
            if(WIN32)
                string(TOLOWER "${output_key}" output_key)
            endif()
            string(SHA256 native_output "${config}:${output_key}")
            set(native_${native_output} "${target}")

            foreach(dependency IN LISTS dependencies)
                set(producer "")
                set(subdirectory "")
                set(explicit_file FALSE)
                if(TARGET "${dependency}")
                    get_property(type TARGET "${dependency}" PROPERTY TYPE)
                    if(NOT type IN_LIST LY_TARGET_TYPES_WITH_RUNTIME_OUTPUTS OR type STREQUAL "UTILITY")
                        continue()
                    endif()
                    set(source_expression "$<TARGET_FILE:${dependency}>")
                    get_property(is_imported TARGET "${dependency}" PROPERTY IMPORTED)
                    if(NOT is_imported)
                        ly_de_alias_target("${dependency}" producer)
                    endif()
                    get_property(runtime_directory TARGET "${dependency}" PROPERTY RUNTIME_OUTPUT_DIRECTORY)
                    if(runtime_directory)
                        ly_runtime_paths("${runtime_directory}" "${config}" runtime_directory)
                        ly_runtime_paths("${CMAKE_RUNTIME_OUTPUT_DIRECTORY}" "${config}" runtime_root)
                        cmake_path(RELATIVE_PATH runtime_directory BASE_DIRECTORY "${runtime_root}" OUTPUT_VARIABLE subdirectory)
                    endif()
                elseif(dependency MATCHES "^([^\n]*)\n?(.*)$")
                    set(explicit_file TRUE)
                    set(source_expression "${CMAKE_MATCH_1}")
                    set(subdirectory "${CMAKE_MATCH_2}")
                    if(source_expression MATCHES "^\\$<TARGET_FILE:([^>]+)>$")
                        get_property(is_imported TARGET "${CMAKE_MATCH_1}" PROPERTY IMPORTED)
                        if(NOT is_imported)
                            ly_de_alias_target("${CMAKE_MATCH_1}" producer)
                        endif()
                    endif()
                endif()
                ly_runtime_paths("${source_expression}" "${config}" source_files)
                ly_runtime_paths("${subdirectory}" "${config}" subdirectory)
                list(LENGTH source_files source_count)
                foreach(source IN LISTS source_files)
                    if(source STREQUAL "")
                        continue()
                    endif()
                    cmake_path(ABSOLUTE_PATH source BASE_DIRECTORY "${binary_dir}" NORMALIZE)
                    if(APPLE AND (source MATCHES "\\.[Ff]ramework(/|$)" OR IS_DIRECTORY "${source}"))
                        set_property(TARGET "${target}" APPEND PROPERTY LY_RUNTIME_DIRECTORY_DEPENDENCIES "${dependency}")
                        continue()
                    endif()
                    set(chain "")
                    while(TRUE)
                        cmake_path(GET source FILENAME filename)
                        set(destination "${output_directory}")
                        cmake_path(APPEND destination "${subdirectory}" "${filename}")
                        cmake_path(NORMAL_PATH destination)
                        set(source_key "${source}")
                        set(destination_key "${destination}")
                        if(WIN32)
                            string(TOLOWER "${source_key}" source_key)
                            string(TOLOWER "${destination_key}" destination_key)
                        endif()
                        if(source_key STREQUAL destination_key)
                            if(explicit_file AND producer AND NOT producer STREQUAL target)
                                list(APPEND runtime_producers_${target} "${producer}")
                            endif()
                            break()
                        endif()
                        string(SHA256 output "${config}:${destination_key}")
                        set(link "")
                        set(next_source "")
                        set(copy_script "${LY_RUNTIME_FILE_COPY_SCRIPT}")
                        if(COMMAND ly_runtime_file_copy_action)
                            ly_runtime_file_copy_action("${source}" link copy_script)
                        endif()
                        if(NOT link AND IS_SYMLINK "${source}")
                            if(source_key IN_LIST chain)
                                message(FATAL_ERROR "Runtime file symlink cycle at ${source}")
                            endif()
                            list(APPEND chain "${source_key}")
                            file(READ_SYMLINK "${source}" next_source)
                            cmake_path(GET next_source FILENAME link)
                        endif()
                        if(DEFINED source_${output})
                            if(NOT source_key STREQUAL source_key_${output})
                                message(FATAL_ERROR "Conflicting runtime sources for ${destination} (${config}):\n"
                                    "  ${source_${output}} requested by ${consumers_${output}}\n"
                                    "  ${source} requested by ${target}")
                            endif()
                        else()
                            list(APPEND outputs "${output}")
                            cmake_path(GET destination ROOT_PATH destination_root)
                            list(APPEND destination_roots "${destination_root}")
                            set(source_${output} "${source}")
                            set(source_key_${output} "${source_key}")
                            set(destination_${output} "${destination}")
                            set(config_${output} "${config}")
                            set(link_${output} "${link}")
                            set(copy_script_${output} "${copy_script}")
                            set(origin_${output} "${source_key}")
                            if(source_count EQUAL 1 AND NOT chain)
                                set(origin_${output} "${source_expression}|${subdirectory}")
                            endif()
                        endif()
                        list(APPEND consumers_${output} "${target}")
                        if(producer)
                            set(producer_${output} "${producer}")
                        endif()
                        if(NOT source_expression MATCHES "\\$<" AND EXISTS "${source}" AND NOT link
                            AND copy_script STREQUAL "${LY_RUNTIME_FILE_COPY_SCRIPT}")
                            set(literal_${output} TRUE)
                        endif()
                        if(NOT next_source)
                            break()
                        endif()
                        cmake_path(GET source PARENT_PATH source_directory)
                        cmake_path(ABSOLUTE_PATH next_source BASE_DIRECTORY "${source_directory}" NORMALIZE OUTPUT_VARIABLE source)
                    endwhile()
                endforeach()
            endforeach()
        endforeach()
    endforeach()

    # Keep each producer in just one utility target. Files with the same consumers share a VS project.
    foreach(output IN LISTS outputs)
        if(DEFINED native_${output})
            message(FATAL_ERROR "Runtime copy from ${source_${output}} requested by ${consumers_${output}} "
                "would overwrite ${destination_${output}} built by ${native_${output}}")
        endif()
        set(consumers "${consumers_${output}}")
        list(REMOVE_DUPLICATES consumers)
        list(SORT consumers)
        string(SHA256 group "${consumers}")
        if(NOT DEFINED members_${group})
            list(APPEND groups "${group}")
            set(targets_${group} "${consumers}")
        endif()
        list(APPEND members_${group} "${output}")
    endforeach()

    set(copy_command -E copy "<SOURCE>" "<STAGED_FILE>")
    if(LY_RUNTIME_FILE_COPY_SCRIPT)
        set(copy_command "-DLY_STAGE_SOURCE=<SOURCE>" "-DLY_STAGE_DESTINATION=<STAGED_FILE>" -P "${LY_RUNTIME_FILE_COPY_SCRIPT}")
    endif()
    add_custom_rule(ly_copy_runtime_file
        OUTPUT "<STAGED_FILE>"
        COMMAND "${CMAKE_COMMAND}" ${copy_command}
        DEPENDS ${LY_RUNTIME_FILE_COPY_SCRIPT}
    )
    list(REMOVE_DUPLICATES destination_roots)
    set_property(RULE ly_copy_runtime_file PROPERTY OUTPUT_FILE_SET_BASE_DIRS "${destination_roots}")
    set_property(RULE ly_copy_runtime_file PROPERTY COMMENT "COPY <STAGED_DISPLAY_PATH>")
    set_property(RULE ly_copy_runtime_file PROPERTY VERBATIM ON)
    foreach(group IN LISTS groups)
        string(SUBSTRING "${group}" 0 12 group_name)
        set(owner "ly_runtime_files_${group_name}")
        # Combine configuration variants so VS always has an input and output for shared rules.
        # A literal file can only appear once in a custom file set on the same target.
        set(entries "")
        foreach(output IN LISTS members_${group})
            if(literal_${output})
                set(origin "${source_key_${output}}")
            else()
                set(origin "${origin_${output}}")
            endif()
            string(SHA256 entry "${group}:${origin}:${copy_script_${output}}:${link_${output}}")
            set(config "${config_${output}}")
            if(config IN_LIST configurations_${entry})
                set(entry "${output}")
            endif()
            if(NOT DEFINED configurations_${entry})
                list(APPEND entries "${entry}")
                set(literal_input_${entry} "${source_${output}}")
                set(use_rule_${entry} "${literal_${output}}")
                set(copy_script_${entry} "${copy_script_${output}}")
            endif()
            list(APPEND configurations_${entry} "${config}")
            set(destination "${destination_${output}}")
            cmake_path(GET destination PARENT_PATH directory)
            cmake_path(RELATIVE_PATH destination BASE_DIRECTORY "${CMAKE_BINARY_DIR}" OUTPUT_VARIABLE display_path)
            string(APPEND input_${entry} "$<$<CONFIG:${config}>:${source_${output}}>")
            string(APPEND output_${entry} "$<$<CONFIG:${config}>:${destination}>")
            string(APPEND directory_${entry} "$<$<CONFIG:${config}>:${directory}>")
            string(APPEND display_${entry} "$<$<CONFIG:${config}>:${display_path}>")
            if(link_${output})
                set(symlink_${entry} TRUE)
                string(APPEND link_target_${entry} "$<$<CONFIG:${config}>:${link_${output}}>")
                if(IS_ABSOLUTE "${link_${output}}")
                    string(APPEND link_input_${entry} "$<$<CONFIG:${config}>:${link_${output}}>")
                endif()
            endif()
            if(producer_${output})
                set(build_target_${entry} "${producer_${output}}")
            endif()
            if(NOT literal_${output} OR entry STREQUAL output OR build_target_${entry})
                set(use_rule_${entry} FALSE)
            endif()
        endforeach()

        set(command_outputs "")
        foreach(entry IN LISTS entries)
            if(use_rule_${entry})
                continue()
            endif()
            set(copy_command -E copy "${input_${entry}}" "${output_${entry}}")
            set(make_directory "")
            if(symlink_${entry})
                set(make_directory COMMAND "${CMAKE_COMMAND}" -E make_directory "${directory_${entry}}")
                set(copy_command -E create_symlink "${link_target_${entry}}" "${output_${entry}}")
            elseif(copy_script_${entry})
                set(copy_command "-DLY_STAGE_SOURCE=${input_${entry}}" "-DLY_STAGE_DESTINATION=${output_${entry}}"
                    -P "${copy_script_${entry}}")
            endif()
            add_custom_command(OUTPUT "${output_${entry}}"
                ${make_directory}
                COMMAND "${CMAKE_COMMAND}" ${copy_command}
                DEPENDS "${input_${entry}}" "${link_input_${entry}}" ${build_target_${entry}} ${copy_script_${entry}}
                COMMENT "COPY ${display_${entry}}" VERBATIM)
            list(APPEND command_outputs "${output_${entry}}")
        endforeach()
        add_custom_target("${owner}" DEPENDS ${command_outputs})
        foreach(entry IN LISTS entries)
            if(use_rule_${entry})
                cmake_path(GET literal_input_${entry} PARENT_PATH input_directory)
                set(file_set "copy_${entry}")
                target_sources("${owner}" PRIVATE FILE_SET "${file_set}" TYPE ly_copy_runtime_file
                    BASE_DIRS "${input_directory}" FILES "${literal_input_${entry}}")
                set_property(FILE_SET "${file_set}" TARGET "${owner}" PROPERTY RULE_PATTERNS
                    "STAGED_FILE=${output_${entry}}"
                    "STAGED_DISPLAY_PATH=${display_${entry}}")
            endif()
        endforeach()
        set_property(TARGET "${owner}" PROPERTY FOLDER "Runtime Dependencies")
        if(COMMAND ly_configure_runtime_staging_target)
            ly_configure_runtime_staging_target("${owner}")
        endif()
        foreach(target IN LISTS targets_${group})
            add_dependencies("${target}" "${owner}")
        endforeach()
    endforeach()
    foreach(target IN LISTS targets)
        if(runtime_producers_${target})
            list(REMOVE_DUPLICATES runtime_producers_${target})
            add_dependencies("${target}" ${runtime_producers_${target}})
        endif()
    endforeach()
endfunction()
