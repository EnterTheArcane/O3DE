<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <!-- CMake emits items with empty outputs for copies inactive in the selected configuration. -->
    <Target Name="O3DESkipInactiveRuntimeCopyCommands" BeforeTargets="SelectCustomBuild">
        <ItemGroup>
            <CustomBuild Remove="@(CustomBuild)" Condition="'%(CustomBuild.Outputs)' == ''" />
        </ItemGroup>
    </Target>
</Project>
