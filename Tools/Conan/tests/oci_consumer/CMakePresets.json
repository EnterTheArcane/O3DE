{
  "version": 4,
  "configurePresets": [
    {
      "name": "oci-consumer",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/../../../../build/conan-oci/oci_consumer/${presetName}",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Release"
      }
    },
    {
      "name": "windows",
      "hidden": true,
      "inherits": "oci-consumer",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
      }
    },
    {
      "name": "windows-x64",
      "inherits": "windows",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    },
    {
      "name": "windows-a64",
      "inherits": "windows",
      "architecture": {
        "value": "ARM64",
        "strategy": "external"
      }
    },
    {
      "name": "linux",
      "hidden": true,
      "inherits": "oci-consumer",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++-13"
      }
    },
    {
      "name": "linux-x64",
      "inherits": "linux"
    },
    {
      "name": "linux-a64",
      "inherits": "oci-consumer",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Linux",
        "CMAKE_SYSTEM_PROCESSOR": "aarch64",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS_INIT": "--target=aarch64-linux-gnu"
      },
      "environment": {
        "PKG_CONFIG_LIBDIR": "/usr/lib/aarch64-linux-gnu/pkgconfig:/usr/share/pkgconfig"
      }
    },
    {
      "name": "macos-a64",
      "inherits": "oci-consumer",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0"
      }
    },
    {
      "name": "android",
      "hidden": true,
      "inherits": "oci-consumer",
      "toolchainFile": "${sourceDir}/../../../../cmake/Platform/Android/Toolchain_android.cmake",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Profile;Release"
      }
    },
    {
      "name": "android-a64",
      "inherits": "android",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a"
      }
    },
    {
      "name": "android-x64",
      "inherits": "android",
      "cacheVariables": {
        "ANDROID_ABI": "x86_64"
      }
    },
    {
      "name": "ios",
      "hidden": true,
      "inherits": "oci-consumer",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "26.0"
      }
    },
    {
      "name": "ios-a64",
      "inherits": "ios",
      "cacheVariables": {
        "CMAKE_OSX_SYSROOT": "iphoneos"
      }
    },
    {
      "name": "ios-simulator-a64",
      "inherits": "ios",
      "cacheVariables": {
        "CMAKE_OSX_SYSROOT": "iphonesimulator"
      }
    },
    {
      "name": "emscripten-w32",
      "inherits": "oci-consumer",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake"
    },
    {
      "name": "emscripten-w64",
      "inherits": "emscripten-w32",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-m64",
        "CMAKE_CXX_FLAGS": "-m64"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "configuration": "Release"
    },
    {
      "name": "windows-a64",
      "configurePreset": "windows-a64",
      "configuration": "Release"
    },
    {
      "name": "linux-x64",
      "configurePreset": "linux-x64",
      "configuration": "Release"
    },
    {
      "name": "linux-a64",
      "configurePreset": "linux-a64",
      "configuration": "Release"
    },
    {
      "name": "macos-a64",
      "configurePreset": "macos-a64",
      "configuration": "Release"
    },
    {
      "name": "android-a64",
      "configurePreset": "android-a64",
      "configuration": "Release"
    },
    {
      "name": "android-x64",
      "configurePreset": "android-x64",
      "configuration": "Release"
    },
    {
      "name": "ios-a64",
      "configurePreset": "ios-a64",
      "configuration": "Release"
    },
    {
      "name": "ios-simulator-a64",
      "configurePreset": "ios-simulator-a64",
      "configuration": "Release"
    },
    {
      "name": "emscripten-w32",
      "configurePreset": "emscripten-w32",
      "configuration": "Release"
    },
    {
      "name": "emscripten-w64",
      "configurePreset": "emscripten-w64",
      "configuration": "Release"
    }
  ]
}
