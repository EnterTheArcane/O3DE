include(common/llvm)
include(common/windows-sdk)

[settings]
os=Windows
arch=x86_64
build_type=Release
compiler.cppstd=20
compiler.runtime=dynamic
compiler.runtime_version=v145

[options]
fmt/*:header_only=True
giflib/*:utils=False
libtiff/*:jpeg=libjpeg-turbo
minizip-ng/*:with_openssl=False

[conf]
# Boost.Container 1.84 passes int pointers to the Windows Interlocked APIs.
boost/1.84.0:tools.build:cflags+=["-Wno-error=incompatible-pointer-types"]
# Include the CRT header before NASM 2.15.05 defines its noreturn macro.
nasm/*:tools.build:cflags+=["-FIsetjmp.h"]
tools.cmake.cmaketoolchain:generator=Ninja
tools.graph:skip_binaries=False
