include(common/llvm)

{% set boost_driver_flags = ["--target=aarch64-linux-gnu", "--gcc-install-dir=/usr/lib/gcc-cross/aarch64-linux-gnu/13"] %}

[settings]
os=Linux
arch=armv8
build_type=Release
compiler.cppstd=20
compiler.libcxx=libstdc++11

[options]
fmt/*:header_only=True
libtiff/*:jpeg=libjpeg-turbo
minizip-ng/*:with_openssl=False

[conf]
# Boost.Build needs the target GCC headers and runtime when invoking Clang.
boost/*:tools.build:cxxflags+={{ boost_driver_flags | tojson }}
boost/*:tools.build:sharedlinkflags+={{ boost_driver_flags | tojson }}
tools.cmake.cmaketoolchain:generator=Ninja
tools.cmake.cmaketoolchain:system_processor=aarch64
# Keep pkg-config pointed at the target when PySide invokes CMake.
tools.cmake.cmaketoolchain:extra_variables={"ENV{PKG_CONFIG_LIBDIR}":"/usr/lib/aarch64-linux-gnu/pkgconfig:/usr/share/pkgconfig"}
# glibc iconv accepts an empty encoding name, even when DCMTK cannot run its probe.
dcmtk/*:tools.cmake.cmaketoolchain:extra_variables*={"DCMTK_STDLIBC_ICONV_HAS_DEFAULT_ENCODING":1}
tools.graph:skip_binaries=False

[buildenv]
CUDAHOSTCXX=aarch64-linux-gnu-g++-13
PKG_CONFIG_LIBDIR=/usr/lib/aarch64-linux-gnu/pkgconfig:/usr/share/pkgconfig
