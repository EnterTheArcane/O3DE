include(common/macos-a64)

{% set llvm_version = "23.1.5" %}

[settings]
compiler=clang
compiler.version={{ llvm_version.split('.')[0] }}
compiler.libcxx=libc++

[tool_requires]
*: llvm/{{ llvm_version }}

[conf]
user.toolchain:llvm={{ llvm_version }}
tools.info.package_id:confs+=["user.toolchain:llvm"]
