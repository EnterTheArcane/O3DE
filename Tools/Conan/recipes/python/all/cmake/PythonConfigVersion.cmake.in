set(PACKAGE_VERSION "@PYTHON_VERSION@")
set(PACKAGE_VERSION_COMPATIBLE FALSE)
if(PACKAGE_FIND_VERSION_COUNT EQUAL 1)
    string(REGEX MATCH "^[0-9]+" _python_requested_precision "${PACKAGE_VERSION}")
elseif(PACKAGE_FIND_VERSION_COUNT EQUAL 2)
    string(REGEX MATCH "^[0-9]+[.][0-9]+" _python_requested_precision "${PACKAGE_VERSION}")
else()
    set(_python_requested_precision "${PACKAGE_VERSION}")
endif()
if(_python_requested_precision VERSION_EQUAL PACKAGE_FIND_VERSION)
    set(PACKAGE_VERSION_EXACT TRUE)
endif()
unset(_python_requested_precision)
if(NOT PACKAGE_FIND_VERSION_MAJOR EQUAL 3 OR PACKAGE_VERSION VERSION_LESS PACKAGE_FIND_VERSION)
    return()
endif()
if(PACKAGE_FIND_VERSION_RANGE AND
    (PACKAGE_VERSION VERSION_GREATER PACKAGE_FIND_VERSION_MAX OR
    (PACKAGE_FIND_VERSION_RANGE_MAX STREQUAL "EXCLUDE" AND PACKAGE_VERSION VERSION_EQUAL PACKAGE_FIND_VERSION_MAX)))
    return()
endif()
set(PACKAGE_VERSION_COMPATIBLE TRUE)
