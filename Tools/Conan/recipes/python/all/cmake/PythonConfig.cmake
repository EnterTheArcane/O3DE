set(_python_package "${CMAKE_FIND_PACKAGE_NAME}")
set(_python_version "@PYTHON_VERSION@")
string(REPLACE "." ";" _python_version_parts "${_python_version}")
list(GET _python_version_parts 0 _python_major)
list(GET _python_version_parts 1 _python_minor)
list(GET _python_version_parts 2 _python_patch)
set(_python_version_short "${_python_major}.${_python_minor}")
set(_python_version_digits "${_python_major}${_python_minor}")

set(_python_home "${CMAKE_CURRENT_LIST_DIR}")
set(_python_executable "")
set(_python_include "")
set(_python_library "")
set(_python_dll "")
set(_python_runtime_files "")
set(_python_soabi "")
set(_python_dynamic_modules TRUE)
include("${CMAKE_CURRENT_LIST_DIR}/PythonLayout.cmake")
if(NOT _python_soabi)
    file(GLOB _python_extensions "${_python_stdlib}/lib-dynload/_struct.*.so")
    if(_python_extensions)
        list(GET _python_extensions 0 _python_extension)
        get_filename_component(_python_extension "${_python_extension}" NAME)
        if(_python_extension MATCHES "^_struct[.](.+)[.]so$")
            set(_python_soabi "${CMAKE_MATCH_1}")
        endif()
    endif()
endif()

set(${_python_package}_VERSION "${_python_version}")
set(${_python_package}_VERSION_MAJOR "${_python_major}")
set(${_python_package}_VERSION_MINOR "${_python_minor}")
set(${_python_package}_VERSION_PATCH "${_python_patch}")
set(${_python_package}_HOME "${_python_home}")
set(${_python_package}_PATHS "${_python_paths}")
set(${_python_package}_RUNTIME_FILES "${_python_runtime_files}")
set(${_python_package}_STDLIB "${_python_stdlib}")
set(${_python_package}_STDARCH "${_python_stdlib}")
set(${_python_package}_SITELIB "${_python_stdlib}/site-packages")
set(${_python_package}_SITEARCH "${_python_stdlib}/site-packages")
set(${_python_package}_SOABI "${_python_soabi}")
set(${_python_package}_SOSABI "abi3")
set(${_python_package}_DEBUG_POSTFIX "")
set(${_python_package}_LIBRARY "${_python_library}")
set(${_python_package}_LIBRARIES "${_python_library}")
set(${_python_package}_INCLUDE_DIR "${_python_include}")
set(${_python_package}_INCLUDE_DIRS "${_python_include}")
set(${_python_package}_Interpreter_FOUND FALSE)
set(${_python_package}_Development_FOUND FALSE)
set(${_python_package}_Development.Embed_FOUND FALSE)
set(${_python_package}_Development.Module_FOUND FALSE)
set(${_python_package}_Development.SABIModule_FOUND FALSE)

# A caller may supply a host interpreter or a virtual environment.
if(NOT ${_python_package}_EXECUTABLE AND NOT CMAKE_CROSSCOMPILING)
    set(${_python_package}_EXECUTABLE "${_python_executable}")
endif()
if(EXISTS "${${_python_package}_EXECUTABLE}")
    set(${_python_package}_Interpreter_FOUND TRUE)
    set(${_python_package}_INTERPRETER_ID Python)
    if(NOT TARGET ${_python_package}::Interpreter)
        add_executable(${_python_package}::Interpreter IMPORTED)
        set_property(TARGET ${_python_package}::Interpreter PROPERTY IMPORTED_LOCATION "${${_python_package}_EXECUTABLE}")
    endif()
endif()

if(EXISTS "${_python_include}/Python.h" AND EXISTS "${_python_library}")
    set(${_python_package}_Development.Embed_FOUND TRUE)

    if(NOT TARGET ${_python_package}::Python)
        if(_python_dll)
            add_library(${_python_package}::Python SHARED IMPORTED)
            set_target_properties(${_python_package}::Python PROPERTIES
                IMPORTED_LOCATION "${_python_dll}"
                IMPORTED_IMPLIB "${_python_library}"
                IMPORTED_LOCATION_DEBUG "${_python_dll_debug}"
                IMPORTED_IMPLIB_DEBUG "${_python_library_debug}")
        else()
            add_library(${_python_package}::Python UNKNOWN IMPORTED)
            set_property(TARGET ${_python_package}::Python PROPERTY IMPORTED_LOCATION "${_python_library}")
        endif()
        set_property(TARGET ${_python_package}::Python PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${_python_include}")
    endif()

    if(_python_dynamic_modules)
        set(${_python_package}_Development_FOUND TRUE)
        set(${_python_package}_Development.Module_FOUND TRUE)
        set(${_python_package}_Development.SABIModule_FOUND TRUE)
        if(NOT TARGET ${_python_package}::Module)
            foreach(_python_component IN ITEMS Module SABIModule)
                add_library(${_python_package}::${_python_component} INTERFACE IMPORTED)
                set_property(TARGET ${_python_package}::${_python_component} PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${_python_include}")
                if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
                    target_link_options(${_python_package}::${_python_component} INTERFACE "LINKER:-undefined,dynamic_lookup")
                endif()
            endforeach()
            if(_python_dll)
                target_link_libraries(${_python_package}::Module INTERFACE ${_python_package}::Python)
                target_compile_definitions(${_python_package}::SABIModule INTERFACE Py_NO_LINK_LIB)
                target_link_libraries(${_python_package}::SABIModule INTERFACE
                    "${_python_home}/libs/python3$<$<CONFIG:Debug>:_d>.lib")
            elseif(ANDROID OR CMAKE_SYSTEM_NAME STREQUAL "iOS")
                foreach(_python_component IN ITEMS Module SABIModule)
                    target_link_libraries(${_python_package}::${_python_component} INTERFACE ${_python_package}::Python)
                endforeach()
            endif()
        endif()
    endif()
endif()

if(_python_dll)
    if(NOT ${_python_package}_EXECUTABLE_DEBUG AND NOT CMAKE_CROSSCOMPILING)
        set(${_python_package}_EXECUTABLE_DEBUG "${_python_home}/python_d.exe")
    endif()
    if(EXISTS "${${_python_package}_EXECUTABLE_DEBUG}" AND TARGET ${_python_package}::Interpreter
        AND NOT TARGET ${_python_package}::InterpreterDebug)
        add_executable(${_python_package}::InterpreterDebug IMPORTED)
        set_property(TARGET ${_python_package}::InterpreterDebug PROPERTY IMPORTED_LOCATION "${${_python_package}_EXECUTABLE_DEBUG}")
        add_executable(${_python_package}::InterpreterMultiConfig IMPORTED)
        set_target_properties(${_python_package}::InterpreterMultiConfig PROPERTIES
            IMPORTED_LOCATION "${${_python_package}_EXECUTABLE}"
            IMPORTED_LOCATION_DEBUG "${${_python_package}_EXECUTABLE_DEBUG}")
    endif()
    set(${_python_package}_LIBRARY_DEBUG "${_python_library_debug}")
    set(${_python_package}_LIBRARIES
        optimized "${_python_library}" debug "${_python_library_debug}")
    set(${_python_package}_DEBUG_POSTFIX "_d")
    set(${_python_package}_SOSABI "")
endif()

set(${_python_package}_FOUND TRUE)
unset(${_python_package}_NOT_FOUND_MESSAGE)
set(_python_components "${${_python_package}_FIND_COMPONENTS}")
if(NOT _python_components)
    set(_python_components Interpreter)
    set(${_python_package}_FIND_REQUIRED_Interpreter TRUE)
endif()
foreach(_python_component IN LISTS _python_components)
    if(${_python_package}_FIND_REQUIRED_${_python_component} AND NOT ${_python_package}_${_python_component}_FOUND)
        set(${_python_package}_FOUND FALSE)
        set(${_python_package}_NOT_FOUND_MESSAGE "CPython ${_python_version} does not provide ${_python_component}")
        break()
    endif()
endforeach()

include("${CMAKE_CURRENT_LIST_DIR}/PythonAddLibrary.cmake")
