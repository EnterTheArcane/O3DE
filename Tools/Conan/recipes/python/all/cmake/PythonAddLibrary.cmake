function(_vendored_python_add_library package name)
    cmake_parse_arguments(PARSE_ARGV 2 arg "STATIC;SHARED;MODULE;WITH_SOABI" "USE_SABI" "")
    if(arg_STATIC OR arg_SHARED)
        if(arg_STATIC)
            set(type STATIC)
        else()
            set(type SHARED)
        endif()
        add_library(${name} ${type} ${arg_UNPARSED_ARGUMENTS})
        target_link_libraries(${name} PRIVATE ${package}::Python)
        return()
    endif()

    add_library(${name} MODULE ${arg_UNPARSED_ARGUMENTS})
    set_target_properties(${name} PROPERTIES PREFIX "")
    if(WIN32)
        set_target_properties(${name} PROPERTIES SUFFIX ".pyd" DEBUG_POSTFIX "${${package}_DEBUG_POSTFIX}")
    endif()
    set(abi "${${package}_SOABI}")
    if(DEFINED arg_USE_SABI)
        target_link_libraries(${name} PRIVATE ${package}::SABIModule)
        if(NOT arg_USE_SABI MATCHES "^3(\\.[0-9]+)?$" OR
            (NOT arg_USE_SABI STREQUAL "3" AND arg_USE_SABI VERSION_LESS 3.2))
            message(FATAL_ERROR "USE_SABI requires a Python version of 3.2 or newer")
        endif()
        set(minor 2)
        if(arg_USE_SABI MATCHES "^3\\.([0-9]+)$")
            set(minor "${CMAKE_MATCH_1}")
        endif()
        math(EXPR version "0x03000000 + (${minor} << 16)" OUTPUT_FORMAT HEXADECIMAL)
        target_compile_definitions(${name} PRIVATE "Py_LIMITED_API=${version}")
        set(abi "${${package}_SOSABI}")
    else()
        target_link_libraries(${name} PRIVATE ${package}::Module)
    endif()
    if(arg_WITH_SOABI AND abi)
        if(WIN32)
            set(suffix ".pyd")
        else()
            set(suffix "${CMAKE_SHARED_MODULE_SUFFIX}")
        endif()
        set_property(TARGET ${name} PROPERTY SUFFIX ".${abi}${suffix}")
    endif()
endfunction()

if(CMAKE_FIND_PACKAGE_NAME STREQUAL "Python3")
    function(Python3_add_library)
        _vendored_python_add_library(Python3 ${ARGV})
    endfunction()
else()
    function(Python_add_library)
        _vendored_python_add_library(Python ${ARGV})
    endfunction()
endif()
