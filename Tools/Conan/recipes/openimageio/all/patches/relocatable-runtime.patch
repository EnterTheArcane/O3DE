--- a/src/cmake/compiler.cmake
+++ b/src/cmake/compiler.cmake
@@ -877,5 +877,7 @@
     # add the automatically determined parts of the RPATH that
     # point to directories outside the build tree to the install RPATH
-    set (CMAKE_INSTALL_RPATH_USE_LINK_PATH TRUE)
+    if (NOT DEFINED CMAKE_INSTALL_RPATH_USE_LINK_PATH)
+        set (CMAKE_INSTALL_RPATH_USE_LINK_PATH TRUE)
+    endif ()
     message (VERBOSE "CMAKE_INSTALL_RPATH = ${CMAKE_INSTALL_RPATH}")
 endif ()
--- a/src/libOpenImageIO/CMakeLists.txt
+++ b/src/libOpenImageIO/CMakeLists.txt
@@ -170,3 +170,10 @@
+# The Python bindings are a separate module. Drop unused shared dependencies from this library.
+if (CMAKE_SYSTEM_NAME STREQUAL "Linux")
+    target_link_options (OpenImageIO PRIVATE "LINKER:--as-needed")
+elseif (CMAKE_SYSTEM_NAME STREQUAL "Darwin")
+    target_link_options (OpenImageIO PRIVATE "LINKER:-dead_strip_dylibs")
+endif ()
+
 # Google Highway (hwy) is an optional optimization dependency.
 set (_oiio_use_hwy 0)
 if (OIIO_USE_HWY AND TARGET hwy::hwy)
--- a/src/cmake/pythonutils.cmake
+++ b/src/cmake/pythonutils.cmake
@@ -230,3 +230,17 @@
+    if (CMAKE_SYSTEM_NAME MATCHES "^(Darwin|Linux)$")
+        get_filename_component (_oiio_python_install_dir "${PYTHON_SITE_DIR}" ABSOLUTE
+                                BASE_DIR "${CMAKE_INSTALL_PREFIX}")
+        file (RELATIVE_PATH _oiio_python_lib_dir "${_oiio_python_install_dir}"
+              "${CMAKE_INSTALL_FULL_LIBDIR}")
+        if (APPLE)
+            set (_oiio_python_origin "@loader_path")
+        else ()
+            set (_oiio_python_origin "$ORIGIN")
+        endif ()
+        set_target_properties (${target_name} PROPERTIES INSTALL_RPATH
+            "${_oiio_python_origin}/${_oiio_python_lib_dir};${CMAKE_INSTALL_RPATH}")
+    endif ()
+
     install (TARGETS ${target_name}
              RUNTIME DESTINATION ${PYTHON_SITE_DIR} COMPONENT user
              LIBRARY DESTINATION ${PYTHON_SITE_DIR} COMPONENT user)
