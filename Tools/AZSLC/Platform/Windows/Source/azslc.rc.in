#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION    @azslc_VERSION_MAJOR@,@azslc_VERSION_MINOR@,@azslc_VERSION_PATCH@,0
PRODUCTVERSION @azslc_VERSION_MAJOR@,@azslc_VERSION_MINOR@,@azslc_VERSION_PATCH@,0
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0
FILEOS         VOS__WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Contributors to the Open 3D Engine Project"
            VALUE "FileDescription",  "Amazon Shader Language Compiler"
            VALUE "FileVersion",      "@azslc_VERSION@"
            VALUE "InternalName",     "azslc"
            VALUE "LegalCopyright",   "SPDX-License-Identifier: Apache-2.0 OR MIT"
            VALUE "OriginalFilename", "azslc.exe"
            VALUE "ProductName",      "AZSL Compiler"
            VALUE "ProductVersion",   "@azslc_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
